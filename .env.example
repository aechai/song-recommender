TOGETHER_API_KEY=your_together_api_key_here
SESSION_SECRET=replace_with_a_long_random_string

# Spotify OAuth (create an app in the Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8010/auth/spotify/callback

# Google OAuth (create an OAuth Client in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/auth/google/callback
